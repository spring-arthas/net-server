<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:jdbc="http://www.springframework.org/schema/jdbc"
    xmlns:tx="http://www.springframework.org/schema/tx"
    xmlns:task="http://www.springframework.org/schema/task"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
                        http://www.springframework.org/schema/jdbc http://www.springframework.org/schema/jdbc/spring-jdbc-3.1.xsd
                        http://www.springframework.org/schema/tx http://www.springframework.org/schema/tx/spring-tx.xsd
                        http://www.springframework.org/schema/task http://www.springframework.org/schema/task/spring-task-3.0.xsd">

    <!-- 配置使Spring采用CGLIB代理（编程式事务不需要，已注释）-->
    <!--<aop:aspectj-autoproxy
    proxy-target-class="true" />-->

    <!-- 启用对事务注解的支持 -->
    <tx:annotation-driven transaction-manager="transactionManager" />

    <!-- [修改] 本机默认从 ~/.net-server/database.properties 读取，部署环境变量优先覆盖。 -->
    <bean id="localDatabaseProperties"
        class="org.springframework.beans.factory.config.PropertiesFactoryBean">
        <property name="location">
            <bean class="org.springframework.core.io.FileSystemResource">
                <constructor-arg value="#{systemProperties['user.home'] + '/.net-server/database.properties'}" />
            </bean>
        </property>
        <property name="ignoreResourceNotFound" value="true" />
    </bean>

    <!--创建jdbc数据源 -->
    <bean id="dataSource" class="com.alibaba.druid.pool.DruidDataSource" init-method="init"
        destroy-method="close">
        <property name="driverClassName" value="com.mysql.cj.jdbc.Driver" />
        <property name="url"
            value="#{systemEnvironment['NET_SERVER_DB_URL'] ?: @localDatabaseProperties['url']}" />
        <property name="username"
            value="#{systemEnvironment['NET_SERVER_DB_USERNAME'] ?: @localDatabaseProperties['username']}" />
        <property name="password"
            value="#{systemEnvironment.containsKey('NET_SERVER_DB_PASSWORD') ? systemEnvironment['NET_SERVER_DB_PASSWORD'] : @localDatabaseProperties['password']}" />
        <!-- 配置初始化大小、最小、最大 -->
        <property name="initialSize" value="1" />
        <property name="minIdle" value="1" />
        <property name="maxActive" value="50" />
        <!-- 配置获取连接等待超时的时间 -->
        <property name="maxWait" value="10000" />
        <!-- 配置间隔多久才进行一次检测，检测需要关闭的空闲连接，单位是毫秒 -->
        <property name="timeBetweenEvictionRunsMillis" value="60000" />
        <!-- 配置一个连接在池中最小生存的时间，单位是毫秒 -->
        <property name="minEvictableIdleTimeMillis" value="300000" />
        <property name="testWhileIdle" value="true" />
        <!-- 这里建议配置为TRUE，防止取到的连接不可用 -->
        <property name="testOnBorrow" value="true" />
        <property name="testOnReturn" value="false" />
        <!-- 打开PSCache，并且指定每个连接上PSCache的大小 -->
        <property name="poolPreparedStatements" value="true" />
        <property name="maxPoolPreparedStatementPerConnectionSize" value="20" />
        <!-- 这里配置提交方式，默认就是TRUE，可以不用配置 -->
        <property name="defaultAutoCommit" value="true" />
        <!-- 验证连接有效与否的SQL，不同的数据配置不同 -->
        <property name="validationQuery" value="select 1 " />
        <property name="filters" value="stat" />
    </bean>

    <!-- 配置Session工厂 -->
    <bean id="sqlSessionFactory" class="org.mybatis.spring.SqlSessionFactoryBean">
        <!-- 注入DataSource -->
        <property name="dataSource" ref="dataSource" />
        <!-- 需要加载的mapper.xml，该bean被
        创建后，会自动加载这些文件。 -->
        <property name="mapperLocations" value="classpath*:mappers/*.xml"></property>
        <!--<property
        name="configLocation" value="classpath:mybatis/mybatis-config.xml"/>-->
        <property name="configuration" ref="mapConfiguration" />

        <property name="plugins">
            <list>
                <bean id="pageInterceptor"
                    class="com.alibaba.server.nio.core.repository.PageInterceptor"></bean>
            </list>
        </property>
    </bean>

    <bean id="mapConfiguration" class="com.alibaba.server.nio.core.repository.MapConfiguration">
        <property name="mapUnderscoreToCamelCase" value="true" />
        <property name="objectFactory" ref="paginatedListObjFactory" />
        <property name="objectWrapperFactory" ref="paginatedListWrapperFactory" />
        <!-- [修改] 登录查询包含密码字段，禁止 MyBatis 打印 SQL 参数和用户结果行。 -->
        <property name="logImpl" value="org.apache.ibatis.logging.nologging.NoLoggingImpl" />
    </bean>
    <bean id="paginatedListObjFactory"
        class="com.alibaba.server.nio.core.page.PaginatedListObjFactory" />
    <bean id="paginatedListWrapperFactory"
        class="com.alibaba.server.nio.core.page.PaginatedListWrapperFactory" />
    <!--<bean
    id="pageInterceptor" class="com.alibaba.server.nio.core.repository.PageInterceptor"/>-->

    <!-- 配置MapperScannerConfigurer -->
    <bean id="mapperScannerConfigurer" class="org.mybatis.spring.mapper.MapperScannerConfigurer">
        <!-- 注入需要扫描的包，它会自动扫描
        这个包下的接口，然后实现这些接口，
        并且会实例化这些接口的实现类。 -->
        <property name="basePackage" value="com.alibaba.server" />
        <property name="sqlSessionFactoryBeanName" value="sqlSessionFactory" />
        <property name="annotationClass" value="org.apache.ibatis.annotations.Mapper" />
    </bean>

    <!-- 事务管理器 -->
    <bean id="transactionManager"
        class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
        <property name="dataSource" ref="dataSource" />
    </bean>

    <bean id="userService"
        class="com.alibaba.server.nio.repository.user.service.impl.UserServiceImpl"
        scope="singleton" />

    <bean id="userFriendsService"
          class="com.alibaba.server.nio.repository.user.service.impl.UserFriendsServiceImpl"
          scope="singleton" />

    <bean id="userFriendApplyService"
          class="com.alibaba.server.nio.repository.user.service.impl.UserFriendApplyServiceImpl"
          scope="singleton" />

    <bean id="friendshipService"
          class="com.alibaba.server.nio.repository.user.service.impl.FriendshipServiceImpl"
          scope="singleton" />

    <bean id="userFriendMessageService"
          class=" com.alibaba.server.nio.repository.chat.service.impl.UserFriendMessageServiceImpl"
          scope="singleton" />

    <!-- [修改] 动态协议由 net-server 本身处理，不需要额外服务进程。 -->
    <bean id="userDynamicService"
          class="com.alibaba.server.nio.repository.dynamic.service.impl.UserDynamicServiceImpl"
          scope="singleton" />

    <bean id="taskService"
        class="com.alibaba.server.nio.repository.task.service.impl.TaskServiceImpl"
        scope="singleton" />

    <bean id="fileService"
        class="com.alibaba.server.nio.repository.file.service.impl.FileServiceImpl"
        scope="singleton" />

    <bean id="fileTaskService"
        class="com.alibaba.server.nio.repository.file.service.impl.FileTaskServiceImpl"
        scope="singleton" />
</beans>
